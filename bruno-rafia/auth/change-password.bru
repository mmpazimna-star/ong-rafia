meta {
  name: Changer mon mot de passe (éditeur)
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/users/me/password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{editorToken}}
}

body:json {
  {
    "currentPassword": "{{editorPassword}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("statut attendu", function () {
    expect([200, 204]).to.include(res.getStatus());
  });
}
