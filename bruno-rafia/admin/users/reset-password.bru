meta {
  name: Réinitialiser mot de passe
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}/reset-password
  body: json
  auth: inherit
}

body:json {
  {
    "newPassword": "{{editorPassword}}"
  }
}

tests {
  test("statut attendu", function () {
    expect([200, 204]).to.include(res.getStatus());
  });
}
