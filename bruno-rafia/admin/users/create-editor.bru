meta {
  name: Créer un éditeur
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Éditeur Test",
    "email": "{{editorEmail}}",
    "password": "{{editorPassword}}",
    "role": "editor"
  }
}

script:post-response {
  if ([200, 201].includes(res.status)) {
    const b = res.body || {};
    const u = b.user || b.data || b;
    bru.setEnvVar("userId", u._id || u.id);
  }
}

tests {
  test("statut attendu", function () {
    expect([200, 201, 400, 409]).to.include(res.getStatus());
  });
}
